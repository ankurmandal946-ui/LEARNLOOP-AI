rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // Global Hardened Primitives
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function hasUserProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // =========================================================================
    // Entity Validation Blueprints (Anti-Update-Gap)
    // =========================================================================

    function isValidUserProfile(data) {
      return data.keys().hasAll([
        'uid', 'displayName', 'personaType', 'country', 'institutionName',
        'institutionType', 'educationCategory', 'educationLevel', 'customEducationLevel',
        'gradeOrYear', 'degreeOrProgramme', 'departmentOrBranch', 'designation',
        'teachingExperience', 'preferredLanguage', 'skillLevel', 'learningGoals',
        'subjectsList', 'streakDays', 'totalStudyMinutes', 'diagnosticCompleted',
        'onboardingCompleted', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid', 'displayName', 'personaType', 'country', 'institutionName',
        'institutionType', 'educationCategory', 'educationLevel', 'customEducationLevel',
        'gradeOrYear', 'degreeOrProgramme', 'departmentOrBranch', 'designation',
        'teachingExperience', 'preferredLanguage', 'skillLevel', 'learningGoals',
        'subjectsList', 'streakDays', 'totalStudyMinutes', 'diagnosticCompleted',
        'onboardingCompleted', 'createdAt', 'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.personaType is string && data.personaType.size() <= 40 &&
      data.personaType in ['student', 'teacher', 'professor', 'tutor', 'institution_admin', 'independent_learner'] &&
      data.country is string && data.country.size() <= 80 &&
      data.institutionName is string && data.institutionName.size() <= 160 &&
      data.institutionType is string && data.institutionType.size() <= 60 &&
      data.educationCategory is string && data.educationCategory.size() <= 40 &&
      data.educationLevel is string && data.educationLevel.size() <= 100 &&
      data.customEducationLevel is string && data.customEducationLevel.size() <= 120 &&
      data.gradeOrYear is string && data.gradeOrYear.size() <= 80 &&
      data.degreeOrProgramme is string && data.degreeOrProgramme.size() <= 120 &&
      data.departmentOrBranch is string && data.departmentOrBranch.size() <= 120 &&
      data.designation is string && data.designation.size() <= 100 &&
      data.teachingExperience is string && data.teachingExperience.size() <= 80 &&
      data.preferredLanguage is string && data.preferredLanguage.size() >= 1 && data.preferredLanguage.size() <= 60 &&
      data.skillLevel is string && data.skillLevel.size() <= 40 &&
      data.skillLevel in ['foundational', 'intermediate', 'advanced', 'exam-prep'] &&
      data.learningGoals is string && data.learningGoals.size() <= 600 &&
      data.subjectsList is list && data.subjectsList.size() <= 30 &&
      (data.subjectsList.size() == 0 || (data.subjectsList[0] is string && data.subjectsList[0].size() <= 100)) &&
      data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 10000 &&
      data.totalStudyMinutes is int && data.totalStudyMinutes >= 0 && data.totalStudyMinutes <= 10000000 &&
      data.diagnosticCompleted is bool &&
      data.onboardingCompleted is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
      data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt']) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.uid == request.auth.uid &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidAcademicSubject(data) {
      return data.keys().hasAll([
        'ownerId', 'name', 'category', 'courseCode', 'educationLevel',
        'description', 'chaptersList', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'name', 'category', 'courseCode', 'educationLevel',
        'description', 'chaptersList', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 80 &&
      data.courseCode is string && data.courseCode.size() <= 40 &&
      data.educationLevel is string && data.educationLevel.size() <= 100 &&
      data.description is string && data.description.size() <= 600 &&
      data.chaptersList is list && data.chaptersList.size() <= 50 &&
      (data.chaptersList.size() == 0 || (data.chaptersList[0] is string && data.chaptersList[0].size() <= 120)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSubjectTopic(data) {
      return data.keys().hasAll([
        'ownerId', 'subjectId', 'subjectName', 'chapterName', 'name',
        'formulaOrKeyRule', 'score', 'questionsAttempted', 'questionsCorrect',
        'totalTimeSeconds', 'difficultyTier', 'status', 'lastChangeReason',
        'misconceptions', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'subjectId', 'subjectName', 'chapterName', 'name',
        'formulaOrKeyRule', 'score', 'questionsAttempted', 'questionsCorrect',
        'totalTimeSeconds', 'difficultyTier', 'status', 'lastChangeReason',
        'misconceptions', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 128 && data.subjectId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120 &&
      data.chapterName is string && data.chapterName.size() >= 1 && data.chapterName.size() <= 120 &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
      data.formulaOrKeyRule is string && data.formulaOrKeyRule.size() <= 240 &&
      data.score is int && data.score >= 0 && data.score <= 100 &&
      data.questionsAttempted is int && data.questionsAttempted >= 0 && data.questionsAttempted <= 100000 &&
      data.questionsCorrect is int && data.questionsCorrect >= 0 && data.questionsCorrect <= 100000 &&
      data.totalTimeSeconds is int && data.totalTimeSeconds >= 0 && data.totalTimeSeconds <= 100000000 &&
      data.difficultyTier is string && data.difficultyTier.size() <= 40 &&
      data.difficultyTier in ['foundational', 'intermediate', 'advanced', 'exam-prep'] &&
      data.status is string && data.status.size() <= 40 &&
      data.status in ['needs-focus', 'developing', 'proficient', 'mastered'] &&
      data.lastChangeReason is string && data.lastChangeReason.size() <= 400 &&
      data.misconceptions is list && data.misconceptions.size() <= 25 &&
      (data.misconceptions.size() == 0 || (data.misconceptions[0] is string && data.misconceptions[0].size() <= 240)) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidGeneratedQuestionSet(data) {
      return data.keys().hasAll([
        'ownerId', 'title', 'subjectName', 'chapterName', 'educationLevel',
        'examType', 'questionFormat', 'difficulty', 'questionCount',
        'marksPerQuestion', 'negativeMarksScaled', 'timeLimitMinutes',
        'language', 'questions', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'title', 'subjectName', 'chapterName', 'educationLevel',
        'examType', 'questionFormat', 'difficulty', 'questionCount',
        'marksPerQuestion', 'negativeMarksScaled', 'timeLimitMinutes',
        'language', 'questions', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120 &&
      data.chapterName is string && data.chapterName.size() <= 120 &&
      data.educationLevel is string && data.educationLevel.size() <= 100 &&
      data.examType is string && data.examType.size() <= 100 &&
      data.questionFormat is string && data.questionFormat.size() <= 80 &&
      data.difficulty is string && data.difficulty.size() <= 40 &&
      data.questionCount is int && data.questionCount >= 1 && data.questionCount <= 100 &&
      data.marksPerQuestion is int && data.marksPerQuestion >= 1 && data.marksPerQuestion <= 100 &&
      data.negativeMarksScaled is int && data.negativeMarksScaled >= 0 && data.negativeMarksScaled <= 10000 &&
      data.timeLimitMinutes is int && data.timeLimitMinutes >= 1 && data.timeLimitMinutes <= 600 &&
      data.language is string && data.language.size() <= 60 &&
      data.questions is list && data.questions.size() <= 100 &&
      (data.questions.size() == 0 || data.questions[0] is map) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidExamAttempt(data) {
      return data.keys().hasAll([
        'ownerId', 'title', 'mode', 'subjectName', 'totalQuestions',
        'correctCount', 'scoreScaled', 'maxMarksScaled', 'percentage',
        'timeTakenSeconds', 'misconceptionsCount', 'calculationErrorsCount',
        'incompleteCount', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'title', 'mode', 'subjectName', 'totalQuestions',
        'correctCount', 'scoreScaled', 'maxMarksScaled', 'percentage',
        'timeTakenSeconds', 'misconceptionsCount', 'calculationErrorsCount',
        'incompleteCount', 'status', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.mode is string && data.mode.size() <= 40 &&
      data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120 &&
      data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 200 &&
      data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 200 &&
      data.scoreScaled is int && data.scoreScaled >= -20000 && data.scoreScaled <= 1000000 &&
      data.maxMarksScaled is int && data.maxMarksScaled >= 100 && data.maxMarksScaled <= 1000000 &&
      data.percentage is int && data.percentage >= 0 && data.percentage <= 100 &&
      data.timeTakenSeconds is int && data.timeTakenSeconds >= 0 && data.timeTakenSeconds <= 86400 &&
      data.misconceptionsCount is int && data.misconceptionsCount >= 0 && data.misconceptionsCount <= 200 &&
      data.calculationErrorsCount is int && data.calculationErrorsCount >= 0 && data.calculationErrorsCount <= 200 &&
      data.incompleteCount is int && data.incompleteCount >= 0 && data.incompleteCount <= 200 &&
      data.status is string && data.status.size() <= 30 &&
      data.status in ['in_progress', 'completed'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSpacedRevisionItem(data) {
      return data.keys().hasAll([
        'ownerId', 'topicKey', 'subjectName', 'topicName', 'dueDate',
        'intervalDays', 'repetitions', 'easeFactorScaled', 'lastScore',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'topicKey', 'subjectName', 'topicName', 'dueDate',
        'intervalDays', 'repetitions', 'easeFactorScaled', 'lastScore',
        'status', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.topicKey is string && data.topicKey.size() >= 1 && data.topicKey.size() <= 128 &&
      data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120 &&
      data.topicName is string && data.topicName.size() >= 1 && data.topicName.size() <= 140 &&
      data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
      data.intervalDays is int && data.intervalDays >= 0 && data.intervalDays <= 3650 &&
      data.repetitions is int && data.repetitions >= 0 && data.repetitions <= 10000 &&
      data.easeFactorScaled is int && data.easeFactorScaled >= 130 && data.easeFactorScaled <= 500 &&
      data.lastScore is int && data.lastScore >= 0 && data.lastScore <= 100 &&
      data.status is string && data.status.size() <= 30 &&
      data.status in ['due', 'upcoming', 'mastered'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidEducatorClass(data) {
      return data.keys().hasAll([
        'ownerId', 'name', 'subjectName', 'educationLevel', 'institutionName',
        'inviteCode', 'rosterList', 'assignmentsList', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'name', 'subjectName', 'educationLevel', 'institutionName',
        'inviteCode', 'rosterList', 'assignmentsList', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
      data.subjectName is string && data.subjectName.size() >= 1 && data.subjectName.size() <= 120 &&
      data.educationLevel is string && data.educationLevel.size() <= 100 &&
      data.institutionName is string && data.institutionName.size() <= 160 &&
      data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 24 && data.inviteCode.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.rosterList is list && data.rosterList.size() <= 50 &&
      (data.rosterList.size() == 0 || data.rosterList[0] is map) &&
      data.assignmentsList is list && data.assignmentsList.size() <= 50 &&
      (data.assignmentsList.size() == 0 || data.assignmentsList[0] is map) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidStudyDocument(data) {
      return data.keys().hasAll([
        'ownerId', 'title', 'fileName', 'mimeType', 'subjectName',
        'summary', 'revisionNotes', 'extractedTopics', 'flashcards',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'title', 'fileName', 'mimeType', 'subjectName',
        'summary', 'revisionNotes', 'extractedTopics', 'flashcards',
        'createdAt', 'updatedAt'
      ]) &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ownerId == request.auth.uid &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 160 &&
      data.mimeType is string && data.mimeType.size() >= 1 && data.mimeType.size() <= 80 &&
      data.subjectName is string && data.subjectName.size() <= 120 &&
      data.summary is string && data.summary.size() <= 8000 &&
      data.revisionNotes is string && data.revisionNotes.size() <= 8000 &&
      data.extractedTopics is list && data.extractedTopics.size() <= 40 &&
      (data.extractedTopics.size() == 0 || (data.extractedTopics[0] is string && data.extractedTopics[0].size() <= 140)) &&
      data.flashcards is list && data.flashcards.size() <= 50 &&
      (data.flashcards.size() == 0 || data.flashcards[0] is map) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // =========================================================================
    // Collection Match Blocks (Exhaustive Blueprint Coverage)
    // =========================================================================

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidUserProfile(incoming()) &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'personaType', 'country', 'institutionName',
            'institutionType', 'educationCategory', 'educationLevel',
            'customEducationLevel', 'gradeOrYear', 'degreeOrProgramme',
            'departmentOrBranch', 'designation', 'teachingExperience',
            'preferredLanguage', 'skillLevel', 'learningGoals',
            'subjectsList', 'onboardingCompleted', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'streakDays', 'totalStudyMinutes', 'diagnosticCompleted', 'updatedAt'
          ])
        );
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    match /userPrivate/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUserPrivateInfo(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidUserPrivateInfo(incoming()) &&
        isValidId(userId) &&
        request.auth.uid == userId &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
      allow delete: if isVerifiedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    match /subjects/{subjectId} {
      allow get: if isSignedIn() && isValidId(subjectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(subjectId) &&
        isValidAcademicSubject(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasUserProfile();
      allow update: if isVerifiedUser() &&
        isValidAcademicSubject(incoming()) &&
        isValidId(subjectId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'category', 'courseCode', 'educationLevel',
          'description', 'chaptersList', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(subjectId) && existing().ownerId == request.auth.uid;
    }

    match /topics/{topicId} {
      allow get: if isSignedIn() && isValidId(topicId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(topicId) &&
        isValidSubjectTopic(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/subjects/$(incoming().subjectId)) &&
        get(/databases/$(database)/documents/subjects/$(incoming().subjectId)).data.ownerId == request.auth.uid;
      allow update: if isVerifiedUser() &&
        isValidSubjectTopic(incoming()) &&
        isValidId(topicId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().subjectId == existing().subjectId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'subjectName', 'chapterName', 'name', 'formulaOrKeyRule',
          'score', 'questionsAttempted', 'questionsCorrect', 'totalTimeSeconds',
          'difficultyTier', 'status', 'lastChangeReason', 'misconceptions', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(topicId) && existing().ownerId == request.auth.uid;
    }

    match /questionSets/{setId} {
      allow get: if isSignedIn() && isValidId(setId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(setId) &&
        isValidGeneratedQuestionSet(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasUserProfile();
      allow update: if isVerifiedUser() &&
        isValidGeneratedQuestionSet(incoming()) &&
        isValidId(setId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'questions', 'questionCount', 'timeLimitMinutes', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(setId) && existing().ownerId == request.auth.uid;
    }

    match /examAttempts/{attemptId} {
      allow get: if isSignedIn() && isValidId(attemptId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(attemptId) &&
        isValidExamAttempt(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasUserProfile();
      allow update: if isVerifiedUser() &&
        isValidExamAttempt(incoming()) &&
        isValidId(attemptId) &&
        existing().ownerId == request.auth.uid &&
        existing().status != 'completed' &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'correctCount', 'scoreScaled', 'percentage', 'timeTakenSeconds',
          'misconceptionsCount', 'calculationErrorsCount', 'incompleteCount',
          'status', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(attemptId) && existing().ownerId == request.auth.uid;
    }

    match /revisions/{revisionId} {
      allow get: if isSignedIn() && isValidId(revisionId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(revisionId) &&
        isValidSpacedRevisionItem(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasUserProfile();
      allow update: if isVerifiedUser() &&
        isValidSpacedRevisionItem(incoming()) &&
        isValidId(revisionId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().topicKey == existing().topicKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'dueDate', 'intervalDays', 'repetitions', 'easeFactorScaled',
          'lastScore', 'status', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(revisionId) && existing().ownerId == request.auth.uid;
    }

    match /educatorClasses/{classId} {
      allow get: if isSignedIn() && isValidId(classId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(classId) &&
        isValidEducatorClass(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasUserProfile();
      allow update: if isVerifiedUser() &&
        isValidEducatorClass(incoming()) &&
        isValidId(classId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().inviteCode == existing().inviteCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'subjectName', 'educationLevel', 'institutionName',
          'rosterList', 'assignmentsList', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(classId) && existing().ownerId == request.auth.uid;
    }

    match /studyDocuments/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(docId) &&
        isValidStudyDocument(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        hasUserProfile();
      allow update: if isVerifiedUser() &&
        isValidStudyDocument(incoming()) &&
        isValidId(docId) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'subjectName', 'summary', 'revisionNotes',
          'extractedTopics', 'flashcards', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(docId) && existing().ownerId == request.auth.uid;
    }
  }
}
